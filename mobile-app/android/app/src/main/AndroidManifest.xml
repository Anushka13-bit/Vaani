<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.vaanimitra">

    <!-- ── Permissions ──────────────────────────────────────────────────── -->

    <!-- Microphone — required for RecognitionService + AudioCaptureManager -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Network — required for backend API calls (calibration, adapter download) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Bind permissions — system enforces these for RecognitionService/AccessibilityService -->
    <uses-permission android:name="android.permission.BIND_RECOGNITION_SERVICE" />

    <!-- Vibrate — optional, used for haptic feedback on action confirmation -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- READ_CONTACTS — used by AndroidIntentActions for contact name lookup -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- CALL_PHONE — used by AndroidIntentActions.placeCall (direct dial, no UI) -->
    <!-- NOTE: ACTION_DIAL does NOT need this — only ACTION_CALL does. Using DIAL for safety. -->
    <!-- <uses-permission android:name="android.permission.CALL_PHONE" /> -->

    <!-- SEND_SMS — required for sending SMS without opening the SMS app -->
    <!-- NOTE: We use ACTION_SENDTO which opens the SMS app. Uncomment only if going direct. -->
    <!-- <uses-permission android:name="android.permission.SEND_SMS" /> -->

    <!-- SYSTEM_ALERT_WINDOW — for native overlay on low-confidence (flagged as build risk §9) -->
    <!-- <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" /> -->

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".MainApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true"
        tools:targetApi="28">

        <!-- ── Main Activity (React Native) ──────────────────────────────── -->
        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ── PersonalizedRecognitionService ────────────────────────────── -->
        <!--
            CRITICAL (§9 build risk note): This is what registers VaaniMitra as a
            system-wide STT provider. The user must select it in:
            Settings → System → Languages & input → Voice input → Default

            Without this registration, system-wide dictation via the mic button in
            other apps will NOT use VaaniMitra. The RecognitionService is an Android
            system contract — there is NO JavaScript/RN equivalent. It MUST be
            declared here and implemented in Kotlin.
        -->
        <service
            android:name=".recognition.PersonalizedRecognitionService"
            android:label="VaaniMitra Voice"
            android:permission="android.permission.BIND_RECOGNITION_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
        </service>

        <!-- ── AccessibilityActionService ────────────────────────────────── -->
        <!--
            Fallback for filling text fields in third-party apps when standard
            Android Intents are insufficient (e.g., composing a WhatsApp message
            directly rather than via ACTION_SENDTO).

            The user must enable this manually in:
            Settings → Accessibility → Installed services → VaaniMitra

            Per spec §7: this service only reads/acts on UI view hierarchy.
            It does NOT access audio, camera, or screen pixels.
        -->
        <!-- Wake word foreground listener (openWakeWord ONNX — "Hey Lily") -->
        <service
            android:name=".wakeword.WakeWordForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <activity
            android:name=".ui.ClarificationActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.Dialog" />

        <service
            android:name=".actions.AccessibilityActionService"
            android:label="VaaniMitra Accessibility"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>
</manifest>
